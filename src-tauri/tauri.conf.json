{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskody",
  "version": "0.1.11",
  "identifier": "dev.musicoptimizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Deskody",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#101512"
      },
      {
        "label": "tray-panel",
        "title": "Deskody · Hızlı kontrol",
        "url": "index.html?panel=tray",
        "width": 380,
        "height": 580,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#171e19",
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Music that follows your focus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Turkish",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
