{
  "name": "deskody",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/run.mjs tauri",
    "desktop": "node scripts/run.mjs tauri dev",
    "bundle": "node scripts/run.mjs tauri build",
    "test": "vitest run",
    "test:rust": "node scripts/run.mjs cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check": "npm run build && npm test",
    "test:e2e": "playwright test",
    "extension:build": "node scripts/package-extension.mjs",
    "format": "prettier --write src tests browser-extension scripts *.ts *.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
